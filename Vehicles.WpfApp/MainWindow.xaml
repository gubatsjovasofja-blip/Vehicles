<Window x:Class="Vehicles.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="620"
        Width="900"
        MinHeight="550"
        MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6F8">

    <Window.Resources>

        <Style TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="Background" Value="#E8EAF0"/>
            <Setter Property="Foreground" Value="#252525"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DDE0E8"/>
                </Trigger>

                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#F8F9FB"/>
            <Setter Property="Padding" Value="6"/>
        </Style>

    </Window.Resources>

    <Grid Margin="25">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="25"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Vasak kaart -->
        <Border Grid.Column="0"
                Background="White"
                CornerRadius="14"
                Padding="20">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="VehiclesTitleText"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#222222"
                           Margin="0,0,0,15"/>

                <ListBox x:Name="VehicleList"
                         Grid.Row="1"
                         SelectionChanged="VehicleList_SelectionChanged"/>

                <StackPanel Grid.Row="2"
                            Margin="0,15,0,0">

                    <Button x:Name="AddCarButton"
                            Click="AddCar_Click"/>

                    <Button x:Name="AddBoatButton"
                            Click="AddBoat_Click"/>

                    <Button x:Name="AddAmphibiousButton"
                            Click="AddAmphibious_Click"/>

                </StackPanel>
            </Grid>
        </Border>

        <!-- Parem kaart -->
        <Border Grid.Column="2"
                Background="White"
                CornerRadius="14"
                Padding="25">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">

                    <TextBlock x:Name="SelectedVehicleTitleText"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#222222"/>

                    <TextBlock x:Name="SelectedVehicleText"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,12,0,3"/>

                    <TextBlock x:Name="OdometerText"
                               Foreground="#666666"/>

                </StackPanel>

                <StackPanel Grid.Row="1"
                            Margin="0,25,0,0">

                    <TextBlock x:Name="DistanceLabelText"
                               FontWeight="SemiBold"
                               Margin="0,0,0,7"/>

                    <TextBox x:Name="DistanceTextBox"
                             Height="38"
                             Padding="10,7"
                             FontSize="14"
                             BorderBrush="#D4D7DE"
                             BorderThickness="1"/>

                </StackPanel>

                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            Margin="0,12,0,0">

                    <Button x:Name="MoveButton"
                            Width="90"
                            Margin="0,0,7,0"
                            Click="Move_Click"/>

                    <Button x:Name="DriveButton"
                            Width="90"
                            Margin="0,0,7,0"
                            IsEnabled="False"
                            Click="Drive_Click"/>

                    <Button x:Name="SwimButton"
                            Width="90"
                            Margin="0,0,7,0"
                            IsEnabled="False"
                            Click="Swim_Click"/>

                    <Button x:Name="RemoveButton"
                            Width="90"
                            Click="Remove_Click"/>

                </StackPanel>

                <TextBlock x:Name="LogTitleText"
                           Grid.Row="3"
                           FontSize="19"
                           FontWeight="Bold"
                           Foreground="#222222"
                           Margin="0,28,0,10"/>

                <ListBox x:Name="LogList"
                         Grid.Row="4"/>

            </Grid>
        </Border>

    </Grid>
</Window>